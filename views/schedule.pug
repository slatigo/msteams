extends layout

block content
  .container.pb-5
    // --- HEADER SECTION ---
    // --- HEADER SECTION ---
    // --- HEADER SECTION ---
    if !isMoodle || canManage
      .d-flex.justify-content-between.align-items-center.gap-3.mb-4
        if !isMoodle
          div
            if isGlobalView || !subject
              h2.fw-bold.mb-0 All Scheduled Meetings
              p.text-muted.mb-0
                if isAdmin
                  | Admin Overview — Filter and manage sessions across users and subjects
                else
                  | My Created Meetings
            else
              h2.fw-bold.mb-0 #{subject.name} #{subject.code ? `(${subject.code})` : ''}
              if subject.type
                span.badge.mt-1(class=subject.type === 'class' ? 'bg-primary' : 'bg-secondary')= subject.type.toUpperCase()

        if canManage
          .ms-auto
            a.btn.btn-primary(
              href=subject && subject.code ? `/meetings/new?subjectCode=${subject.code}` : '/meetings/new'
            ) + Schedule New Meeting

    // --- ADMIN FILTER TOOLBAR (GLOBAL VIEW ONLY) ---
    if isAdmin && isGlobalView
      .card.shadow-sm.mb-4.border-0.bg-light
        .card-body.p-3
          form.row.g-3.align-items-end(method='GET', action='/meetings')
            .col-12.col-md-4
              label.form-label.small.fw-semibold.text-muted(for='filterSubject') Filter by Subject
              select#filterSubject.form-select.form-select-sm(name='subjectCode')
                option(value='') All Subjects
                each s in subjectsList || []
                  option(value=s.code, selected=(selectedSubject === s.code))= `${s.name} (${s.code})`

            .col-12.col-md-5
              label.form-label.small.fw-semibold.text-muted(for='filterCreator') Filter by User / Creator
              select#filterCreator.form-select.form-select-sm(name='creatorEmail')
                option(value='') All Users / Creators
                each email in creatorsList || []
                  option(value=email, selected=(selectedCreator === email))= email

            .col-12.col-md-3.d-flex.gap-2
              button.btn.btn-sm.btn-primary.flex-grow-1(type='submit') 🔍 Filter
              if selectedSubject || selectedCreator
                a.btn.btn-sm.btn-outline-secondary(href='/meetings') Clear Filters

    // --- REUSABLE MEETING CARD MIXIN ---
    mixin meetingCard(meeting, isPast)
      .card.shadow-sm.border-0(class=isPast ? 'bg-light text-muted opacity-75' : '')
        .card-body.p-3.p-md-4
          .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.gap-3.mb-3
            .flex-grow-1
              .d-flex.align-items-center.gap-2.mb-1.flex-wrap
                if meeting.subjectCode
                  span.badge.bg-primary= meeting.subjectCode
                h5.fw-bold.mb-0= meeting.subject || 'Virtual Classroom Meeting'
                if isPast
                  span.badge.bg-secondary.small Ended
              small.text-muted.d-block Organizer: #{meeting.creatorEmail || 'N/A'}

              // --- MEETING DESCRIPTION ---
              if meeting.description
                p.text-secondary.small.mt-2.mb-0(style='white-space: pre-line;')= meeting.description

              // --- CO-ORGANIZERS ---
              if meeting.coOrganizers && meeting.coOrganizers.length > 0
                .mt-2
                  small.text-muted.fw-semibold.d-block Co-Organizers:
                  .d-flex.flex-wrap.gap-1.mt-1
                    each co in meeting.coOrganizers
                      - const coEmail = typeof co === 'string' ? co : (co.email || '')
                      - const coName = typeof co === 'string' ? co : (co.name || co.email || '')
                      span.badge.bg-white.text-dark.border(title=coEmail)
                        | 👤 #{coName}
                        if coName && coEmail && coName !== coEmail
                          span.text-muted.ms-1 (#{coEmail})

            // --- DATE DISPLAY ---
            if canManage
              .bg-white.p-2.px-3.rounded.small.flex-shrink-0.align-self-start.align-self-md-auto.border
                .d-flex.gap-3
                  div
                    span.text-uppercase.text-muted.d-block(style='font-size: 0.68rem; letter-spacing: 0.5px;') Start
                    strong.d-block= meeting.meetingDate || 'N/A'
                    span.text-muted #{meeting.startTime || ''}
                  div.border-start.ps-3
                    span.text-uppercase.text-muted.d-block(style='font-size: 0.68rem; letter-spacing: 0.5px;') End / Expiry
                    strong.d-block= meeting.expiryDate || meeting.meetingDate || 'N/A'
                    span.text-muted #{meeting.endTime || ''}

          // --- ACTION BUTTONS ---
          .d-flex.flex-column.flex-sm-row.align-items-stretch.align-items-sm-center.justify-content-between.gap-2.pt-3.border-top
            if meeting.joinUrl
              .d-flex.flex-grow-1.gap-2
                a.btn.fw-semibold.flex-grow-1.text-center(
                  class=isPast ? 'btn-outline-secondary' : 'btn-success',
                  href=meeting.joinUrl, 
                  target='_blank', 
                  rel='noopener noreferrer'
                ) 🎥 #{isPast ? 'Rejoin Meeting Room' : 'Join Teams Meeting'}
                button.btn.btn-outline-primary.btn-copy-link(
                  type='button', 
                  data-url=meeting.joinUrl
                ) 📋 Copy Link

            - const activeSubjectCode = meeting.subjectCode || (subject && subject.code)
            if meeting.canEdit && activeSubjectCode
              .d-flex.gap-2.align-items-center.ms-sm-auto.mt-2.mt-sm-0
                a.btn.btn-outline-secondary.btn-sm(href=`/subjects/${activeSubjectCode}/meetings/${meeting.id}/edit`) ✏️ Edit
                button.btn.btn-outline-danger.btn-sm.btn-delete-meeting(
                  type='button', 
                  data-id=meeting.id
                ) 🗑️ Delete

    // --- MAIN SESSIONS LIST DISPLAY ---
    if (!sessions || sessions.length === 0)
      .alert.alert-info No scheduled meetings match your criteria.
    else
      // --- ACTIVE MEETINGS SECTION ---
      .mb-5
        h4.fw-bold.mb-3.d-flex.align-items-center.gap-2
          span 🟢 Active & Upcoming Meetings
          span.badge.bg-success.rounded-pill.fs-6= activeMeetings ? activeMeetings.length : 0

        if (!activeMeetings || activeMeetings.length === 0)
          .alert.alert-light.border No active or upcoming meetings found.
        else
          .d-flex.flex-column.gap-3
            each meeting in activeMeetings
              +meetingCard(meeting, false)

      // --- PREVIOUS / EXPIRED MEETINGS SECTION ---
      if previousMeetings && previousMeetings.length > 0
        .mt-5.pt-3.border-top
          h5.fw-bold.text-muted.mb-3.d-flex.align-items-center.gap-2
            span 📜 Previous Meetings
            span.badge.bg-secondary.rounded-pill.fs-6= previousMeetings.length

          .d-flex.flex-column.gap-3
            each meeting in previousMeetings
              +meetingCard(meeting, true)

  // --- BOOTSTRAP TOAST NOTIFICATION ---
  .toast-container.position-fixed.bottom-0.end-0.p-3(style='z-index: 1100;')
    #appToast.toast.align-items-center.text-bg-dark.border-0(role='alert', aria-live='assertive', aria-atomic='true')
      .d-flex
        .toast-body#toastMessage Notification message here...
        button.btn-close.btn-close-white.me-2.m-auto(type='button', data-bs-dismiss='toast', aria-label='Close')

  // --- BOOTSTRAP DELETE CONFIRMATION MODAL ---
  #deleteModal.modal.fade(tabindex='-1', aria-hidden='true')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title Confirm Deletion
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
        .modal-body
          p.mb-0 Are you sure you want to delete this meeting? This action will remove it from MS Teams and the database.
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Cancel
          button#confirmDeleteBtn.btn.btn-danger(type='button') Delete Meeting

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const toastEl = document.getElementById('appToast');
      const toastMsg = document.getElementById('toastMessage');
      const bsToast = toastEl ? new bootstrap.Toast(toastEl, { delay: 3000 }) : null;

      function showNotification(message, isError = false) {
        if (!bsToast) return;
        toastEl.classList.remove('text-bg-dark', 'text-bg-danger', 'text-bg-success');
        toastEl.classList.add(isError ? 'text-bg-danger' : 'text-bg-dark');
        toastMsg.textContent = message;
        bsToast.show();
      }

      const deleteModalEl = document.getElementById('deleteModal');
      const bsDeleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

      let targetMeetingId = null;

      document.addEventListener('click', async (e) => {
        const copyBtn = e.target.closest('.btn-copy-link');
        if (copyBtn) {
          const url = copyBtn.getAttribute('data-url');
          if (!url) return;

          let copiedSuccessfully = false;

          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(url);
              copiedSuccessfully = true;
            }
          } catch (err) {}

          if (!copiedSuccessfully) {
            try {
              const input = document.createElement('textarea');
              input.value = url;
              input.style.position = 'fixed';
              input.style.opacity = '0';
              document.body.appendChild(input);
              input.focus();
              input.select();
              copiedSuccessfully = document.execCommand('copy');
              document.body.removeChild(input);
            } catch (fallbackErr) {
              copiedSuccessfully = false;
            }
          }

          if (copiedSuccessfully) {
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = 'Copied!';
            showNotification('Meeting link copied to clipboard!');
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          } else {
            showNotification('Failed to copy link automatically.', true);
          }
          return;
        }

        const deleteBtn = e.target.closest('.btn-delete-meeting');
        if (deleteBtn) {
          targetMeetingId = deleteBtn.getAttribute('data-id');
          if (targetMeetingId && bsDeleteModal) {
            bsDeleteModal.show();
          }
        }
      });

      if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener('click', async () => {
          if (!targetMeetingId) return;

          const originalBtnHtml = confirmDeleteBtn.innerHTML;
          confirmDeleteBtn.disabled = true;
          confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Deleting...';

          try {
            const res = await fetch('/api/meetings/' + targetMeetingId, { method: 'DELETE' });
            const data = await res.json();

            if (data.success) {
              if (bsDeleteModal) bsDeleteModal.hide();
              showNotification('Meeting deleted successfully.');
              window.location.reload();
            } else {
              showNotification('Error: ' + (data.error || 'Failed to delete meeting'), true);
            }
          } catch (err) {
            showNotification('Server error processing deletion request.', true);
          } finally {
            confirmDeleteBtn.disabled = false;
            confirmDeleteBtn.innerHTML = originalBtnHtml;
          }
        });
      }
    });