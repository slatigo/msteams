doctype html
html
  head
    title #{subject.name} - Schedule
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-3.mb-md-4
      .container
        if !isMoodle
          a.navbar-brand(href='/subjects') ← Back to All Subjects
        span.navbar-text.small.ms-auto Logged in as: #{user.email}

    .container.pb-5
      // Header Section
      .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4
        div
          h2.fw-bold.mb-0 #{subject.name} (#{subject.code})
          span.badge.mt-1(class=subject.type === 'class' ? 'bg-primary' : 'bg-secondary')= subject.type.toUpperCase()
        if canManage
          a.btn.btn-primary.w-100.w-md-auto(href=`/subjects/${subject.code}/meetings/new`) + Schedule New Meeting

      if sessions.length === 0
        .alert.alert-info No scheduled meetings for this subject yet.
      else
        // --- UNIFORM CARD DISPLAY (All Viewports) ---
        .d-flex.flex-column.gap-3
          each meeting in sessions
            .card.shadow-sm.border-0
              .card-body.p-3.p-md-4
                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.gap-3.mb-3
                  div
                    h5.fw-bold.mb-1= meeting.subject
                    small.text-muted.d-block Organizer: #{meeting.creatorEmail}

                    // Display Co-Organizers
                    if meeting.coOrganizers && meeting.coOrganizers.length > 0
                      .mt-2
                        small.text-muted.fw-semibold.d-block Co-Organizers:
                        .d-flex.flex-wrap.gap-1.mt-1
                          each co in meeting.coOrganizers
                            span.badge.bg-light.text-dark.border(title=co.email)
                              | 👤 #{co.name || co.email}
                              if co.name && co.email && co.name !== co.email
                                span.text-muted.ms-1 (#{co.email})

                  // Date and Time Summary Box
                  .bg-light.p-2.px-3.rounded.small.w-100.w-md-auto
                    .row.g-3
                      .col-6.col-md-auto
                        span.text-uppercase.text-muted.d-block(style='font-size: 0.7rem;') Start
                        strong= meeting.meetingDate
                        span.text-muted.d-block #{meeting.startTime}
                      .col-6.col-md-auto
                        span.text-uppercase.text-muted.d-block(style='font-size: 0.7rem;') End / Expiry
                        strong= meeting.expiryDate || meeting.meetingDate
                        span.text-muted.d-block #{meeting.endTime}

                // Action Buttons Bar
                .d-flex.flex-wrap.align-items-center.gap-2.pt-2.border-top
                  a.btn.btn-success.fw-semibold.flex-grow-1.flex-md-grow-0(href=meeting.joinUrl, target='_blank') Join Teams Meeting
                  button.btn.btn-outline-primary(type='button', onclick=`copyLink('${meeting.joinUrl}', this)`) 📋 Copy Link
                  if meeting.canEdit
                    a.btn.btn-outline-secondary(href=`/subjects/${subject.code}/meetings/${meeting.id}/edit`) ✏️ Edit
                    button.btn.btn-outline-danger(type='button', onclick=`deleteMeeting('${meeting.id}')`) 🗑️ Delete

    script.
      async function copyLink(url, btnElement) {
        try {
          await navigator.clipboard.writeText(url);
          const originalText = btnElement.innerText;
          btnElement.innerText = 'Copied!';
          setTimeout(() => {
            btnElement.innerText = originalText;
          }, 2000);
        } catch (err) {
          const input = document.createElement('input');
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
          alert('Meeting link copied to clipboard!');
        }
      }

      async function deleteMeeting(id) {
        if (!confirm('Are you sure you want to delete this meeting from MS Teams and database?')) return;
        try {
          const res = await fetch('/api/meetings/' + id, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert('Error: ' + (data.error || 'Failed to delete meeting'));
          }
        } catch (err) {
          alert('Server error processing deletion request.');
        }
      }