extends layout

block content
  .container
    .row.justify-content-center
      .col-md-8.col-lg-6
        .card.shadow-sm.border-0
          .card-body.p-4
            h3.fw-bold.mb-4 Add Subject / Meeting Hub

            // --- ERROR ALERT BANNER ---
            if error
              .alert.alert-danger.alert-dismissible.fade.show(role='alert')
                strong Error: 
                | #{error}
                button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Close')

            form(action='/api/subjects', method='POST')
              .mb-3
                label.form-label Subject Code / ID (e.g., ECO101 or DEPT-STAFF)
                input.form-control(
                  type='text', 
                  name='code', 
                  required, 
                  placeholder='ECO101', 
                  value=(formData && formData.code ? formData.code : '')
                )
              .mb-3
                label.form-label Title / Name
                input.form-control(
                  type='text', 
                  name='name', 
                  required, 
                  placeholder='Principles of Macroeconomics', 
                  value=(formData && formData.name ? formData.name : '')
                )
              .mb-3
                label.form-label Category Type
                select.form-select(name='type')
                  option(value='class', selected=(formData && formData.type === 'class')) Class / Course
                  option(value='general', selected=(formData && formData.type === 'general')) General / Departmental
              .mb-3
                label.form-label Description
                textarea.form-control(
                  name='description', 
                  rows='3', 
                  placeholder='Brief description...'
                )= (formData && formData.description ? formData.description : '')
              .d-flex.justify-content-between
                a.btn.btn-secondary(href='/subjects') Cancel
                button.btn.btn-primary(type='submit') Save Subject