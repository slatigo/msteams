doctype html
html
  head
    title MUBS MS Teams - New Subject
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container
        a.navbar-brand(href='/subjects') MUBS Teams Portal
        a.btn.btn-outline-light.btn-sm(href='/logout') Logout
    .container
      .row.justify-content-center
        .col-md-6
          .card.shadow-sm.border-0
            .card-body.p-4
              h3.fw-bold.mb-4 Add Subject / Meeting Hub
              form(action='/api/subjects', method='POST')
                .mb-3
                  label.form-label Subject Code / ID (e.g., ECO101 or DEPT-STAFF)
                  input.form-control(type='text', name='code', required, placeholder='ECO101')
                .mb-3
                  label.form-label Title / Name
                  input.form-control(type='text', name='name', required, placeholder='Principles of Macroeconomics')
                .mb-3
                  label.form-label Category Type
                  select.form-select(name='type')
                    option(value='class') Class / Course
                    option(value='general') General / Departmental
                .mb-3
                  label.form-label Description
                  textarea.form-control(name='description', rows='3', placeholder='Brief description...')
                .d-flex.justify-content-between
                  a.btn.btn-secondary(href='/subjects') Cancel
                  button.btn.btn-primary(type='submit') Save Subject