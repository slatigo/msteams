doctype html
html
  head
    title MUBS MS Teams - Login
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
  body.bg-light.d-flex.align-items-center.min-vh-100
    .container
      .row.justify-content-center
        .col-md-4
          .card.shadow-sm.border-0
            .card-body.p-4
              h3.card-title.fw-bold.mb-3.text-center MUBS Teams Portal
              p.text-center.text-muted.mb-4 Log in to manage schedules
              if error
                .alert.alert-danger= error
              form(action='/login', method='POST')
                .mb-3
                  label.form-label Email Address
                  input.form-control(type='email', name='email', required, placeholder='user@mubs.ac.ug')
                .mb-3
                  label.form-label Password
                  input.form-control(type='password', name='password', required)
                button.btn.btn-primary.w-100(type='submit') Log In