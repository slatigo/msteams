extends layout

block content
  .container.pb-5
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4
      h2.fw-bold.mb-0 Subjects & Meeting Hubs
      if canManage
        a.btn.btn-success.w-100.w-md-auto(href='/subjects/new') + Create New Subject / Hub

    if subjects.length === 0
      .alert.alert-info No subjects or meeting hubs available yet.
    else
      .row
        each sub in subjects
          .col-md-6.col-lg-4.mb-4
            .card.h-100.shadow-sm.border-0
              .card-body.d-flex.flex-column.p-4
                .d-flex.justify-content-between.align-items-start.mb-2
                  h5.card-title.fw-bold.mb-0= sub.name
                  span.badge(class=sub.type === 'class' ? 'bg-primary' : 'bg-secondary')= sub.type ? sub.type.toUpperCase() : 'HUB'
                h6.card-subtitle.text-muted.mb-3 Code: #{sub.code}
                p.card-text.text-secondary.flex-grow-1= sub.description || 'No description provided.'
                a.btn.btn-outline-primary.mt-3.w-100.fw-semibold(href=`/subjects/${sub.code}`) View Schedule